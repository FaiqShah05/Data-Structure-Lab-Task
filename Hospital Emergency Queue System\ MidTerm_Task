#include <iostream>
using namespace std;
class node {
    
    public:
    
    int data;
    node* next;
    node* prev;
    
    node(int id){
        
        data =id ;
        next = nullptr;
        prev = nullptr;
    }
    
};


class hospital_queue{
    
    private:
    
    node* head;
    node* tail;
    int count;
    
    public:
    
    hospital_queue(){
        
        head = tail = nullptr;
        count= 0;
        
    }
    
    void insertatbegining(int id){
        
        
        node* n = new node(id);
        
        if(head==nullptr){
            head = tail = n;
        }
        
        n->next=head;
        if(head !=nullptr)
        {
        head->prev = n;
        head= n;
        count++;
            
        }
        
    }
        void insertatend(int id){
        
        node* n=new node(id);
        node* curr = head;
        
        if(head==nullptr)
        {
            head=tail=n;
        }
        
        else{
        while(curr->next!=nullptr)
        {
            curr=curr->next;
        
        }
        curr->next=n;
        n->prev=curr;
        n->next=nullptr;
        }
        count++;
    
    }
        
    void insertatpostion(int id,int pos)
    {
        
        if(pos<1 || pos>(count+1))
        {
            cout<<"position out of range ";
            return ;
        }
        
        node* n=new node(id);
        node *curr=head;
 
        for(int i =1 ; i<(pos-1) ; i++)
        {
            curr=curr->next;
        }
        
        n->next=curr->next;
        curr->next->prev=n;
        n->prev = curr;
        curr->next= n;
        
        
        count++;
        
        
        
    }
    
    

    
    void deletefromstart()
    {
        node* curr=head;
        if(head != nullptr){
         head= head->next;
         head->prev=nullptr;
         delete curr;
        }
        count--;
        
    }
    
    
    void display(){
        
        node* temp=head;
        
        while(temp!=nullptr)
        {
            cout<<temp->data<<" ";
            temp=temp->next;
        }
        
    }
    
};



#include <iostream>
#include <fstream>
#include <iomanip>
using namespace std;

// =========================
// Node (Student Record)
// =========================
class Node {
public:
    int id;
    string name;
    string dept;
    int sem;
    float cgpa;
    int credits;
    int year;
    Node* next;

    Node(int i, string n, string d, int s, float c, int cr, int y) {
        id = i;
        name = n;
        dept = d;
        sem = s;
        cgpa = c;
        credits = cr;
        year = y;
        next = nullptr;
    }
};

// =========================
// Singly Linked List
// =========================
class StudentList {
public:
    Node* head;

    StudentList() {
        head = nullptr;
    }

    ~StudentList() {
        while (head != nullptr)
            deleteAtBeginning();
    }

    // Insert at end (used while reading file)
    void insertAtEnd(int id, string name, string dept, int sem, float cgpa, int credits, int year) {
        Node* newnode = new Node(id, name, dept, sem, cgpa, credits, year);
        if (head == nullptr) {
            head = newnode;
            return;
        }
        Node* temp = head;
        while (temp->next != nullptr)
            temp = temp->next;
        temp->next = newnode;
    }

    void deleteAtBeginning() {
        if (head == nullptr) return;
        Node* temp = head;
        head = head->next;
        delete temp;
    }

    // =========================
    // Bubble Sort by CGPA (Desc)
    // =========================
    void sortByCGPA() {
        if (head == nullptr) return;
        bool swapped;
        do {
            swapped = false;
            Node* curr = head;
            while (curr->next != nullptr) {
                if (curr->cgpa < curr->next->cgpa) {
                    swapData(curr, curr->next);
                    swapped = true;
                }
                curr = curr->next;
            }
        } while (swapped);
    }

    // =========================
    // Bubble Sort by Enrollment Year (Asc)
    // =========================
    void sortByYear() {
        bool swapped;
        do {
            swapped = false;
            Node* curr = head;
            while (curr->next != nullptr) {
                if (curr->year > curr->next->year) {
                    swapData(curr, curr->next);
                    swapped = true;
                }
                curr = curr->next;
            }
        } while (swapped);
    }

    // =========================
    // Write Ranked by CGPA
    // =========================
    void writeRankedCGPA() {
        ofstream out("ranked_by_cgpa.txt");
        sortByCGPA();
        out << "Rank | ID | Name | CGPA | Dept | Sem | Credits | Year\n";
        out << "------------------------------------------------------\n";
        int rank = 1;
        Node* temp = head;
        while (temp != nullptr) {
            out << rank++ << " | " << temp->id << " | " << temp->name << " | "
                << fixed << setprecision(2) << temp->cgpa << " | "
                << temp->dept << " | " << temp->sem << " | "
                << temp->credits << " | " << temp->year << "\n";
            temp = temp->next;
        }
        out.close();
    }

    // =========================
    // Write Sorted by Enrollment Year
    // =========================
    void writeSortedByYear() {
        ofstream out("sorted_by_enrollment.txt");
        sortByYear();
        Node* temp = head;
        while (temp != nullptr) {
            out << temp->year << " | " << temp->id << " | " << temp->name
                << " | " << temp->cgpa << "\n";
            temp = temp->next;
        }
        out.close();
    }

    // =========================
    // Performance Tiers
    // =========================
    void writePerformanceTiers(int total) {
        ofstream out("performance_tiers.txt");
        Node* temp = head;
        while (temp != nullptr) {
            out << temp->id << " | " << temp->name << " | " << temp->cgpa;
            if (temp->cgpa >= 3.7) out << " | Elite";
            else if (temp->cgpa >= 3.3) out << " | High Achiever";
            else if (temp->cgpa >= 3.0) out << " | Good";
            else if (temp->cgpa >= 2.5) out << " | Satisfactory";
            else out << " | Needs Improvement";
            out << "\n";
            temp = temp->next;
        }
        out.close();
    }

private:
    // Swap student data (NOT nodes)
    void swapData(Node* a, Node* b) {
        swap(a->id, b->id);
        swap(a->name, b->name);
        swap(a->dept, b->dept);
        swap(a->sem, b->sem);
        swap(a->cgpa, b->cgpa);
        swap(a->credits, b->credits);
        swap(a->year, b->year);
    }
};

// =========================
// Main
// =========================
int main() {
    ifstream in("students_data.txt");
    if (!in) {
        cout << "File not found";
        return 0;
    }

    StudentList list;
    int n;
    in >> n;

    for (int i = 0; i < n; i++) {
        int id, sem, credits, year;
        float cgpa;
        string name, dept;
        in >> id >> name >> dept >> sem >> cgpa >> credits >> year;
        list.insertAtEnd(id, name, dept, sem, cgpa, credits, year);
    }
    in.close();

    list.writeRankedCGPA();
    list.writeSortedByYear();
    list.writePerformanceTiers(n);

    return 0;
}
